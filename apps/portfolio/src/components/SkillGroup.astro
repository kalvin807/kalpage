---
interface Props {
  label: string;
  skills: string[];
}

const { label, skills } = Astro.props;
// The non-breaking space keeps each separator on the same line as the skill before it.
---

<div class="grid grid-cols-[6rem_minmax(0,1fr)] border-x border-b border-line sm:grid-cols-[7.5rem_minmax(0,1fr)]">
  <dt class="px-3 py-2.5 text-sm text-text-muted">{label}</dt>
  <dd class="m-0 border-l border-line px-3 py-2.5">{skills.join('\u00a0· ')}</dd>
</div>
