---
interface Props {
  label: string;
  skills: string[];
}

const { label, skills } = Astro.props;
---

<div class="mb-6 last:mb-0">
  <p class="mb-2.5 font-mono text-xs text-accent">{label}</p>
  <div class="flex flex-wrap gap-2">
    {skills.map((skill) => (
      <span class="rounded-md bg-surface-raised px-3 py-1.5 font-mono text-xs text-text">{skill}</span>
    ))}
  </div>
</div>
