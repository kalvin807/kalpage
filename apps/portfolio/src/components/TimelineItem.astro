---
interface Props {
  title: string;
  date: string;
}

const { title, date } = Astro.props;
---

<div class="timeline-item border-b border-accent-10 pb-6 last:border-0 last:pb-0">
  <article>
    <span class="mb-2 block font-mono text-xs tabular-nums text-text-muted">{date}</span>
    <h3 class="font-heading text-base font-semibold text-text-heading m-0 mb-1">{title}</h3>
    <div class="timeline-desc text-sm text-text leading-relaxed">
      <slot />
    </div>
  </article>
</div>
