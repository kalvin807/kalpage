---
interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<li class="border-r border-b border-line">
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${title} on GitHub (opens in a new tab)`}
    class="flex h-full flex-col gap-1 px-4 py-3.5 text-text hover:bg-surface-hover hover:no-underline"
  >
    <span class="flex justify-between gap-4 text-text-heading">
      {title}<span aria-hidden="true" class="text-link">↗</span>
    </span>
    <span class="text-sm text-text-muted">{description}</span>
  </a>
</li>
