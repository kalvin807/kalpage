---
interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---

<a href={href} target="_blank" rel="noopener noreferrer" aria-label={`View ${title} on GitHub (opens in a new tab)`} class="flex flex-col gap-3 rounded-lg border border-accent-10 bg-bg-card p-5 no-underline hover:border-accent-50 focus-visible:border-accent">
  <h3 class="m-0 flex items-start justify-between gap-4 font-heading text-lg font-semibold text-text-heading">
    {title}<span aria-hidden="true" class="font-normal text-text-muted">↗</span>
  </h3>
  <p class="m-0 flex-1 text-sm leading-relaxed text-text">{description}</p>
  <span class="mt-2 font-mono text-xs text-text-muted">View on GitHub</span>
</a>
