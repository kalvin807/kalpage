{
  "name": "kalpage-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --filter tool dev",
    "build": "bun --filter tool build",
    "preview": "bun --filter tool preview",
    "test": "bun --filter tool test",
    "typecheck": "bun --filter tool typecheck",
    "clean": "rm -rf apps/*/dist apps/*/.tanstack apps/*/.vercel apps/*/.output apps/*/node_modules/.nitro",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fix": "bun run lint && bun run fmt",
    "check": "bun run lint:check && bun run fmt:check && bun run typecheck && bun run test",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "knip": "^6.44.1",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2"
}
